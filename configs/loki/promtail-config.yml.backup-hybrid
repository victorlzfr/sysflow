server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /tmp/positions.yaml

clients:
  - url: http://loki:3100/loki/api/v1/push

scrape_configs:
  # 1. Logs Docker - TODOS os containers
  - job_name: docker
    docker_sd_configs:
      - host: unix:///var/run/docker.sock
        refresh_interval: 5s
    relabel_configs:
      - source_labels: ['__meta_docker_container_name']
        regex: '/(.*)'
        target_label: 'container'
      - source_labels: ['__meta_docker_container_name']
        regex: '/(.*)'
        target_label: 'job'
        replacement: 'docker-logs'
      - target_label: 'host'
        replacement: 'localhost'
      - target_label: 'environment'
        replacement: 'sysflow'
    pipeline_stages:
      - docker: {}

  # 2. Logs do sistema (opcional - para referência)
  - job_name: system
    static_configs:
      - targets:
          - localhost
        labels:
          job: 'system-logs'
          host: 'localhost'
          __path__: /var/log/*.log

  # 3. Logs de aplicação específicos (n8n)
  - job_name: n8n
    static_configs:
      - targets:
          - localhost
        labels:
          job: 'n8n'
          host: 'localhost'
          environment: 'sysflow'
          __path__: /var/log/n8n*.log
